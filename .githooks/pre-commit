#!/usr/bin/env bash
owner="harry-ma-qiang <54002917+harry-ma-qiang@users.noreply.github.com>"
me="$(git config user.name) <$(git config user.email)>"
if [ "$me" != "$owner" ]; then echo "pre-commit: git identity is '$me', must be '$owner'" >&2; exit 1; fi
exec "$(git rev-parse --show-toplevel)/scripts/scan-secrets.sh" staged
